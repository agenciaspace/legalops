NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
KIMI_API_KEY=your-kimi-api-key
KIMI_MODEL=moonshot-v1-8k
OPENCODE_GO_API_KEY=your-opencode-go-api-key
OPENCODE_GO_MODEL=deepseek-v4-flash
CRON_SECRET=a-random-secret-string

# Cloudflare Email Service (Email Sending REST API).
# The API token needs Email Sending: Edit permission and the sender domain
# must be onboarded under Cloudflare Email Service > Email Sending.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_EMAIL_API_TOKEN=your-cloudflare-email-api-token
CLOUDFLARE_EMAIL_SENDER_NAME=Legal Ops
CLOUDFLARE_EMAIL_SENDER_EMAIL=hello@mail.legalops.work
CLOUDFLARE_EMAIL_WEBHOOK_TOKEN=another-random-secret-string

# Comma-separated emails allowed to use the future admin invitation endpoint.
LEGALOPS_ADMIN_EMAILS=leonhatori@gmail.com

# Deterministic ATS inventory (comma-separated company board slugs).
# Direct ATS APIs are one layer of the multi-source discovery pipeline.
LEGALOPS_LEVER_SLUGS=hive
LEGALOPS_GREENHOUSE_SLUGS=nubank,vtex,gympass,stripe,cloudflare,databricks,brex,verkada,harbor,airtable,figma

# Optional overrides for the Ashby public Job Posting API and company-site crawler.
# Defaults are defined in lib/job-discovery.ts.
LEGALOPS_ASHBY_BOARDS=
LEGALOPS_CAREER_SITES=

# Aggregator credentials are backend-only and should be stored in Supabase Vault,
# not in NEXT_PUBLIC_* variables or committed env files:
#   JOOBLE_API_KEY
#   ADZUNA_APP_ID
#   ADZUNA_APP_KEY
# JOOBLE_API_ORIGIN can optionally override the official API host.
JOOBLE_API_ORIGIN=https://jooble.org

# Optional hosted checkout links for the annual Club launch cohorts.
CLUB_CHECKOUT_FOUNDER_199_URL=
CLUB_CHECKOUT_FOUNDER_299_URL=
CLUB_CHECKOUT_PIONEER_499_URL=
CLUB_CHECKOUT_LAUNCH_699_URL=
