{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "legalops-club-proxy",
  "main": "legalops-club-proxy.js",
  "compatibility_date": "2026-08-13",
  "routes": [
    {
      "pattern": "legalops.club",
      "custom_domain": true
    },
    {
      "pattern": "legalops.legalops.club",
      "custom_domain": true
    }
  ]
}
