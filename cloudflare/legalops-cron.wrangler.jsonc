{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "legalops-cron",
  "account_id": "3d40d7797b3fd6d1cd2644eefea9e907",
  "main": "legalops-cron.js",
  "compatibility_date": "2026-08-19",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://www.legalops.work"
  },
  "triggers": {
    "crons": ["* * * * *", "0 10 * * *", "0 21 * * SUN", "0 12 * * *"]
  }
}
