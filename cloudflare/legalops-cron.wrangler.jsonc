{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "legalops-cron",
  "main": "legalops-cron.js",
  "compatibility_date": "2026-08-19",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://www.legalops.work"
  },
  "triggers": {
    "crons": ["0 10 * * *", "0 21 * * SUN"]
  }
}
